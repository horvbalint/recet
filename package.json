    "@vue/reactivity": "3.5.42",
    "blurhash": "2.0.5",
    "dayjs": "1.11.21",
    "fuse.js": "7.5.0",
    "nebula": "github:horvbalint/nebula",
    "nuxt": "4.5.2",
    "sortablejs": "1.15.7",
    "surreal-ts": "3.0.0",
    "surrealdb": "2.0.8",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@types/sortablejs": "1.15.9",
    "@vite-pwa/nuxt": "1.1.1",
    "eslint": "10.8.0"
